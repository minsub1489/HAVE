# HAVE 서버가 읽는 환경 변수 목록입니다. 값이 없으면 괄호 안의 기본값을 씁니다.
# 스프링은 .env 파일을 자동으로 읽지 않습니다. 명령 프롬프트에서 `set 이름=값`으로 주거나 IDE의 실행 설정에 넣습니다.
# 실제 값을 적은 .env는 Git에 올리지 않습니다(.gitignore에 있음).

# jdbc 프로필의 DB 접속 (기본: jdbc:postgresql://localhost:5432/have, have, have)
HAVE_DB_URL=jdbc:postgresql://localhost:5432/have
HAVE_DB_USER=have
HAVE_DB_PASSWORD=have

# 결과물 PDF와 근거 파일을 두는 폴더 (기본: ../.have-data/files — 저장소 루트의 .have-data)
HAVE_FILE_DIR=../.have-data/files

# 증명서 서명 키를 두는 폴더 (기본: ../.have-data/keys). 없으면 서버가 시작할 때 만듭니다
HAVE_KEY_DIR=../.have-data/keys

# 로그인 토큰 서명 비밀 값 (기본값은 개발용). 시연 환경에서는 길고 임의인 값으로 바꿉니다
HAVE_TOKEN_SECRET=dev-only-secret-change-me
